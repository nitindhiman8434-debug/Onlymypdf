# OnlyMyPDF frontend env. Copy to .env.local (dev) or .env (docker).
NODE_ENV=development

# Public site URL (used for canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL=https://onlymypdf.com

# Backend API base (server-side rewrite target)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional: Sentry, analytics (low-cost) — leave blank to disable
NEXT_PUBLIC_SENTRY_DSN=
