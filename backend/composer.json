{
    "name": "onlymypdf/backend",
    "type": "project",
    "description": "OnlyMyPDF — Laravel API + Filament admin + queues",
    "keywords": ["laravel", "pdf", "saas"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/horizon": "^5.24",
        "laravel/socialite": "^5.12",
        "filament/filament": "^3.2",
        "predis/predis": "^2.2",
        "razorpay/razorpay": "^2.9",
        "srmklive/paypal": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": { "*": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
