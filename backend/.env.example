# ============================================================
# OnlyMyPDF backend (Laravel) env. Copy to .env and fill in.
# ============================================================
APP_NAME=OnlyMyPDF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# --- Admin panel (configurable path; change in production) ---
ADMIN_PATH=only-admin-panel
ADMIN_EMAIL=admin@onlymypdf.com
ADMIN_PASSWORD=ChangeMe!2026

# --- Database (MariaDB/MySQL) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=onlymypdf
DB_USERNAME=onlymypdf
DB_PASSWORD=change-me-strong

# --- Redis (queues, cache, rate limits) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# --- Product knobs (also editable in admin) ---
TEMP_TTL_MINUTES=60
MONTHLY_CREDITS=2100
DOWNLOAD_URL_TTL=600

# --- Feature flags (DB overrides these at runtime) ---
ASK_PDF_ENABLED=false
ADS_ENABLED=false
SECURE_SHARE_LINKS_ENABLED=false
APPLE_LOGIN_ENABLED=false
HIGH_ACCURACY_ENABLED=true
TRANSLATE_PDF_ENABLED=true
OCR_ENABLED=true
SCANNER_ENABLED=true

# --- Auth: Google login (Socialite) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Payments ---
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- AI / conversion providers (pluggable; worker reads these too) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
CONVERSION_FALLBACK_PROVIDER=

# --- Mail (transactional emails) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@onlymypdf.com
MAIL_FROM_NAME="OnlyMyPDF"

# --- Monitoring ---
SENTRY_LARAVEL_DSN=
