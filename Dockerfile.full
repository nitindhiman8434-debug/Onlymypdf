# Self-hosted image with LibreOffice + Python for Office↔PDF conversions.
# Does NOT modify application conversion code — only provides runtime binaries.
#
# Build:
#   docker build -f Dockerfile.full -t onlymypdf:full .
# Run:
#   docker run -p 3000:3000 --env-file .env.production onlymypdf:full

FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-bookworm-slim AS builder
WORKDIR /app

ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_APP_NAME=OnlyMyPDF
ARG NEXT_PUBLIC_SUPABASE_URL=
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY=
ARG NEXT_PUBLIC_RAZORPAY_KEY_ID=
ARG NEXT_PUBLIC_BILLING_MODE=
ARG NEXT_PUBLIC_DESIGN_PREVIEW=false
ARG NEXT_PUBLIC_CLIENT_PDF_TOOLS=true

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_RAZORPAY_KEY_ID=$NEXT_PUBLIC_RAZORPAY_KEY_ID
ENV NEXT_PUBLIC_BILLING_MODE=$NEXT_PUBLIC_BILLING_MODE
ENV NEXT_PUBLIC_DESIGN_PREVIEW=$NEXT_PUBLIC_DESIGN_PREVIEW
ENV NEXT_PUBLIC_CLIENT_PDF_TOOLS=$NEXT_PUBLIC_CLIENT_PDF_TOOLS
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app

# LibreOffice (PDF↔Word, Word/Excel/PPT→PDF) + Python pdf2docx fallback
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages pdf2docx python-pptx==1.0.2 pillow==12.2.0

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV LIBREOFFICE_PATH=/usr/bin/soffice
ENV PDF2DOCX_PYTHON=/usr/bin/python3

RUN addgroup --system nodejs && adduser --system --ingroup nodejs nextjs

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# The Office routes execute Python scripts by filesystem path at runtime.
# Next.js standalone tracing does not guarantee these dynamic paths are copied.
COPY --from=builder /app/scripts ./scripts

RUN python3 -c "import fitz, pptx; from PIL import Image" \
    && test -f scripts/pdf-to-ppt-build.py \
    && test -f scripts/pdf-extract-tables.py

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
