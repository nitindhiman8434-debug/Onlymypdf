# Isolated conversion worker. It polls the durable Supabase queue and
# reads/writes private staged files in the configured object storage.
FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0 update \
    && apt-get -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0 install -y --no-install-recommends \
    libreoffice-writer \
    python3 \
    python3-pip \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-hin \
    ca-certificates \
    fonts-dejavu-core \
    fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages pdf2docx

COPY package.json package-lock.json ./
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN npm ci --omit=dev
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY workers ./workers

ENV NODE_ENV=production
ENV LIBREOFFICE_PATH=/usr/bin/soffice
ENV PDF2DOCX_PYTHON=/usr/bin/python3
ENV CONVERSION_WORKER_POLL_MS=1000
ENV CONVERSION_WORKER_MAX_POLL_MS=30000
ENV CONVERSION_WORKER_HEARTBEAT_MS=60000
ENV MAX_CONCURRENT_HEAVY_JOBS=1
ENV PDF_OCR_ENABLED=true
ENV PDF_OCR_REQUIRED=true
ENV PDF_OCR_LANGUAGES=eng+hin
ENV PDF_OCR_DPI=220
ENV PDF_OCR_MAX_PAGES=50
ENV OMP_THREAD_LIMIT=1

RUN groupadd --system nodejs \
    && useradd --system --gid nodejs --create-home --home-dir /home/worker worker \
    && chown -R worker:nodejs /app /home/worker

USER worker
CMD ["npm", "run", "worker:conversions"]
