# Isolated Phase 1 conversion worker. It polls the durable Upstash queue and
# reads/writes private staged files in Supabase storage.
FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    python3 \
    python3-pip \
    ca-certificates \
    fonts-dejavu-core \
    fonts-noto-core \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages pdf2docx

COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY workers ./workers

ENV NODE_ENV=production
ENV LIBREOFFICE_PATH=/usr/bin/soffice
ENV PDF2DOCX_PYTHON=/usr/bin/python3
ENV CONVERSION_WORKER_POLL_MS=1000
ENV MAX_CONCURRENT_HEAVY_JOBS=1

RUN groupadd --system nodejs \
    && useradd --system --gid nodejs --create-home --home-dir /home/worker worker \
    && chown -R worker:nodejs /app /home/worker

USER worker
CMD ["npm", "run", "worker:conversions"]
