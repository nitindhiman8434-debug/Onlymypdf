# =============================================================================
# OnlyMyPDF — environment variables (copy to .env.local; never commit real values)
# =============================================================================

# --- Public (exposed to the browser via NEXT_PUBLIC_*) ---
# Safe only when noted. Restrict API keys in Google Cloud / Dropbox consoles.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OnlyMyPDF
# Public legal identity shown in policies and the Trust Center.
# Replace the operator name with the legal owner or registered entity before launch.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=OnlyMyPDF
NEXT_PUBLIC_LEGAL_OPERATOR_COUNTRY=India
NEXT_PUBLIC_PRIVACY_EMAIL=support@onlymypdf.in
# Max width (px) for convert-result PDF page previews in the browser (default 960).
# NEXT_PUBLIC_PREVIEW_THUMB_MAX_WIDTH=960
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# Anon key is client-safe ONLY when Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Set to r2 when browser uploads should use Cloudflare R2 presigned URLs.
NEXT_PUBLIC_FILE_STORAGE_PROVIDER=supabase
# Razorpay publishable key (checkout UI) — secret key stays server-side only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# Google Drive picker — restrict key by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key
NEXT_PUBLIC_DROPBOX_APP_KEY=your_dropbox_app_key
NEXT_PUBLIC_CLIENT_PDF_TOOLS=true
# NEXT_PUBLIC_MAX_FREE_FILE_SIZE_MB=25
# NEXT_PUBLIC_MAX_PRO_FILE_SIZE_MB=200
# NEXT_PUBLIC_BRAND_LOGO=/logo.png
# NEXT_PUBLIC_BRAND_LOGO_ICON=/logo-icon.png
# NEXT_PUBLIC_BRAND_LOGO_SHOW_TEXT=true
# NEXT_PUBLIC_STATUS_PAGE_URL=https://status.onlymypdf.com
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_DESIGN_PREVIEW=false
# NEXT_PUBLIC_BILLING_MODE=mock

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# PDF→Word private object storage. Keep supabase for the existing 50 MB path or
# select r2 for the 200 MB production path.
FILE_STORAGE_PROVIDER=supabase
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=onlymypdf-files
CRON_SECRET=your_random_secret_here
# Optional dedicated secret for detailed /api/health (required for diagnostics in production).
HEALTH_CHECK_SECRET=your_health_check_secret
# Optional dedicated keys. If omitted, CRON_SECRET is used as the cryptographic
# fallback; separate random values make rotation and incident response safer.
UPLOAD_GRANT_SECRET=your_direct_upload_grant_secret
JOB_PAYLOAD_SECRET=your_job_payload_encryption_secret
# Required in production — step-up auth for export/delete/MFA (do not reuse CRON_SECRET).
STEP_UP_SECRET=your_step_up_secret
# Cloudflare Turnstile (required in production for login, signup, contact, password reset).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Used for local-dev auth when Supabase is not configured (dev only).
LOCAL_DEV_SESSION_SECRET=your_local_dev_session_secret
IP_HASH_SALT=change_me_in_production
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=OnlyMyPDF <onboarding@resend.dev>
CONTACT_INBOX_EMAIL=support@onlymypdf.in
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
# Supabase is the default production queue and coordination store after migration 023.
CONVERSION_QUEUE_PROVIDER=supabase
# Optional rollback compatibility only; not required with Supabase coordination.
# UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
SENTRY_DSN=your_sentry_dsn
# Optional but recommended on Vercel for PDF→Word
CONVERTAPI_SECRET=your_convertapi_secret
# Production (big traffic): use cloud API only — skip Word COM / LibreOffice
# PDF_TO_WORD_CONVERTAPI_ONLY=1
# CONVERTAPI_TIMEOUT_MS=180000

# --- Billing (Razorpay — no Stripe in this project) ---
# mock = dev/local only (blocked in production). live = real checkout + webhook.
BILLING_MODE=mock
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Required when BILLING_MODE=live (Razorpay dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_xxxxx
# RAZORPAY_PRO_YEARLY_PLAN_ID=plan_xxxxx
# BILLING_GSTIN=22AAAAA0000A1Z5
# BILLING_LEGAL_NAME=Your Legal Entity Name
# BILLING_GST_RATE=18

# --- App limits ---
MAX_FREE_FILE_SIZE_MB=25
MAX_PRO_FILE_SIZE_MB=200
FILE_RETENTION_HOURS=2
MAX_CONCURRENT_HEAVY_JOBS=2
MAX_UPLOAD_BODY_MB=210
# Production app instances must enqueue only; the isolated worker claims jobs.
INLINE_CONVERSION_WORKER=0
CONVERSION_WORKER_POLL_MS=1000
CONVERSION_WORKER_MAX_POLL_MS=30000
CONVERSION_WORKER_HEARTBEAT_MS=60000
# Only set both flags inside a disposable, network-isolated worker container.
# PUPPETEER_DISABLE_SANDBOX=0
# PUPPETEER_HARDENED_CONTAINER=0
# Preview load control (optional — defaults shown)
# PREVIEW_SESSION_TTL_MINUTES=15
# PREVIEW_THUMB_MAX_WIDTH=960
# NEXT_PUBLIC_PREVIEW_THUMB_MAX_WIDTH=960
ADMIN_EMAIL=admin@pdfdoctor.com

# --- Optional Sentry upload (CI / source maps) ---
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Optional local conversion tooling ---
# PDF2DOCX_PYTHON=C:\Users\You\AppData\Local\Programs\Python\Python312\python.exe
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# --- Local development only (never in production) ---
# Skip CSRF origin checks when testing APIs from Postman/curl on localhost.
# Startup fails if ALLOW_INSECURE_CSRF=1 when NODE_ENV=production.
# ALLOW_INSECURE_CSRF=1

# Self-hosted production only: set after configuring x-real-ip or cf-connecting-ip on your reverse proxy.
# TRUSTED_PROXY_IP_HEADERS=1
