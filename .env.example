# ============================================================
# OnlyMyPDF — ROOT env (shared by docker-compose)
# Copy to .env and fill in. App-specific envs live in
# frontend/.env.example and backend/.env.example.
# ============================================================

# --- General ---
APP_NAME=OnlyMyPDF
APP_DOMAIN=onlymypdf.com
NODE_ENV=development

# --- MySQL / MariaDB ---
DB_DATABASE=onlymypdf
DB_USERNAME=onlymypdf
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-root
DB_HOST=mysql
DB_PORT=3306

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Ports exposed on host ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_PORT=80

# --- Python worker ---
WORKER_CONCURRENCY=2
WORKER_TEMP_DIR=/data/temp

# --- Admin ---
# Configurable admin path (no leading slash needed in some contexts; Laravel uses with slash)
ADMIN_PATH=only-admin-panel
