{
  "name": "pdf-doctor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pdf-to-word-quality": "vitest run src/lib/services/pdf-to-word-quality.ci.test.ts src/lib/services/pdf-to-word-hints.test.ts src/lib/services/pdf-to-word-hints.safety.test.ts src/lib/services/tool-isolation.test.ts src/lib/services/pdf-to-word-convertapi.service.test.ts src/lib/services/pdf-to-word-docx-post.test.ts src/lib/server/upload-validation.test.ts",
    "verify:pdf-to-word": "npx tsx scripts/verify-pdf-to-word-fixes.ts",
    "worker:conversions": "npx tsx workers/conversion-worker.ts",
    "worker:watchdog": "npx tsx workers/conversion-watchdog.ts",
    "phase1:corpus": "npx tsx scripts/phase1-corpus.ts",
    "phase1:upload-boundaries": "npx tsx scripts/phase1-upload-boundaries.ts",
    "phase1:engine-evidence": "npx tsx scripts/phase1-engine-evidence.ts",
    "phase1:local-api-smoke": "npx tsx scripts/phase1-local-api-smoke.ts",
    "phase1:dedicated-worker-smoke": "npx tsx scripts/phase1-dedicated-worker-smoke.ts",
    "phase1:live-200mb": "npx tsx scripts/phase1-live-200mb.ts",
    "phase1:retention-retry": "npx tsx scripts/phase1-retention-retry-drill.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/legal.spec.ts e2e/conversion.spec.ts e2e/checkout.spec.ts e2e/tools.spec.ts",
    "test:e2e:verify": "playwright test e2e/smoke.spec.ts e2e/tools.spec.ts e2e/a11y.spec.ts e2e/cwv.spec.ts e2e/perf-budget.spec.ts",
    "test:all": "npm run test && npm run test:e2e",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "audit:dev": "npm audit --audit-level=high",
    "audit:moderate": "npm audit --audit-level=moderate",
    "clean:next": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "overrides": {
    "postcss": "^8.5.28",
    "esbuild": "^0.25.0",
    "tar": "^7.5.22",
    "axios": "^1.20.0",
    "browserslist": "^4.29.0",
    "dompurify": "^3.4.15",
    "fast-uri": "^3.1.8",
    "image-size": "^2.0.4",
    "js-yaml": "^4.3.2",
    "undici": "^7.29.1",
    "@xmldom/xmldom": "^0.9.12",
    "docx": {
      "nanoid": "^5.1.16"
    },
    "minimatch@^3": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@^5": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@^10": {
      "brace-expansion": "^5.0.12"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.0",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.0.2",
    "@sentry/nextjs": "^10.60.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@types/archiver": "^7.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.2.1",
    "docx": "^9.7.0",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^3.18.0",
    "jszip": "^3.10.1",
    "libreoffice-convert": "^1.8.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "ppt-to-text": "^1.0.1",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.0.4",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "uuid": "^14.0.0",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
